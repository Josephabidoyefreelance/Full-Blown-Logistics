@@ -0,0 +1,149 @@
+import { NextResponse } from 'next/server';
+import { createClient } from '@/lib/supabase/server';
+import PDFDocument from 'pdfkit';
+
+export const dynamic = 'force-dynamic';
+
+function fmtNaira(n: number | null | undefined) {
+  return '\u20a6' + Number(n || 0).toLocaleString('en-NG', { maximumFractionDigits: 0 });
+}
+
+type BookingRow = {
+  tracking_no: string;
+  customer_name: string | null;
+  origin: string;
+  destination: string;
+  type: string | null;
+  status: string | null;
+  weight: string | null;
+  declared_value: number | null;
+};
+
+async function toPdfBuffer(
+  manifest: Record<string, unknown>,
+  bookings: BookingRow[]
+): Promise<Buffer> {
+  return new Promise((resolve, reject) => {
+    const doc = new PDFDocument({ margin: 40, size: 'A4' });
+    const chunks: Buffer[] = [];
+    doc.on('data', (chunk) => chunks.push(chunk));
+    doc.on('end', () => resolve(Buffer.concat(chunks)));
+    doc.on('error', reject);
+
+    const left = doc.page.margins.left;
+    const pageWidth = doc.page.width - doc.page.margins.left - doc.page.margins.right;
+
+    doc.fontSize(18).font('Helvetica-Bold').fillColor('#111').text('DISPATCH MANIFEST', { align: 'center' });
+    doc.moveDown(0.3);
+    doc
+      .fontSize(11)
+      .font('Helvetica-Bold')
+      .fillColor('#dc2626')
+      .text(String(manifest.manifest_no ?? ''), { align: 'center' });
+    doc.moveDown(1);
+
+    function sectionTitle(text: string) {
+      doc.moveDown(0.6);
+      doc.fontSize(11).font('Helvetica-Bold').fillColor('#111').text(text);
+      doc.moveDown(0.2);
+    }
+
+    function row(label: string, value: unknown) {
+      doc
+        .fontSize(9.5)
+        .font('Helvetica')
+        .fillColor('#444')
+        .text(`${label}: `, { continued: true })
+        .font('Helvetica-Bold')
+        .fillColor('#111')
+        .text(String(value ?? '\u2014'));
+    }
+
+    sectionTitle('MANIFEST INFORMATION');
+    row('Manifest Date', manifest.manifest_date);
+    row('Route', manifest.route);
+    row('Driver', manifest.driver_name);
+    row('Vehicle', manifest.vehicle_number);
+    row('Total Shipments', bookings.length);
+
+    sectionTitle('SHIPMENTS ON THIS MANIFEST');
+    const tableTop = doc.y + 4;
+    const colWidths = [90, pageWidth - 90 - 60 - 55 - 70 - 80, 60, 55, 70, 80];
+    const headers = ['Tracking No.', 'Route', 'Type', 'Weight', 'Value', 'Status'];
+
+    doc.rect(left, tableTop, pageWidth, 18).fill('#111');
+    doc.fillColor('#fff').fontSize(8).font('Helvetica-Bold');
+    let x = left;
+    headers.forEach((h, i) => {
+      doc.text(h, x + 4, tableTop + 5, { width: colWidths[i] - 8 });
+      x += colWidths[i];
+    });
+
+    let rowY = tableTop + 18;
+    if (bookings.length === 0) {
+      doc.fillColor('#999').font('Helvetica').fontSize(9).text('No shipments linked to this manifest.', left + 4, rowY + 5);
+      rowY += 20;
+    } else {
+      bookings.forEach((b) => {
+        doc.rect(left, rowY, pageWidth, 18).stroke('#ddd');
+        doc.fillColor('#111').font('Helvetica').fontSize(8);
+        x = left;
+        const cells = [
+          b.tracking_no,
+          `${b.origin} \u2192 ${b.destination}`,
+          b.type ?? '\u2014',
+          b.weight ?? '\u2014',
+          fmtNaira(b.declared_value),
+          b.status ?? '\u2014',
+        ];
+        cells.forEach((c, i) => {
+          doc.text(String(c), x + 4, rowY + 5, { width: colWidths[i] - 8, ellipsis: true });
+          x += colWidths[i];
+        });
+        rowY += 18;
+      });
+    }
+    doc.y = rowY + 8;
+
+    sectionTitle('DECLARATION');
+    doc.fontSize(9).font('Helvetica').fillColor('#444');
+    doc.text('\u2022 The driver named above confirms all shipments listed have been checked and loaded.');
+    doc.text('\u2022 Any discrepancy between this manifest and the physical load must be reported before departure.');
+
+    doc.end();
+  });
+}
+
+export async function GET(_req: Request, { params }: { params: Promise<{ id: string }> }) {
+  const { id } = await params;
+  const supabase = await createClient();
+
+  const { data: manifest, error } = await supabase
+    .from('manifests')
+    .select('id, manifest_no, driver_name, vehicle_number, route, manifest_date')
+    .eq('id', id)
+    .single();
+
+  if (error || !manifest) {
+    return NextResponse.json({ error: error?.message ?? 'Manifest not found.' }, { status: 404 });
+  }
+
+  const { data: links } = await supabase.from('manifest_bookings').select('booking_id').eq('manifest_id', id);
+  const bookingIds = (links ?? []).map((l) => l.booking_id);
+
+  const { data: bookings } = bookingIds.length
+    ? await supabase
+        .from('bookings')
+        .select('tracking_no, customer_name, origin, destination, type, status, weight, declared_value')
+        .in('id', bookingIds)
+    : { data: [] as BookingRow[] };
+
+  const pdfBuffer = await toPdfBuffer(manifest, bookings ?? []);
+
+  return new NextResponse(pdfBuffer, {
+    headers: {
+      'Content-Type': 'application/pdf',
+      'Content-Disposition': `attachment; filename="manifest-${manifest.manifest_no}.pdf"`,
+    },
+  });
+}
